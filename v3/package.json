{
  "name": "constellation-v3",
  "version": "3.0.0",
  "private": true,
  "description": "Constellation v3 - a 3D grand strategy space game",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p server && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "server": "tsx server/index.ts"
  },
  "dependencies": {
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.4",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
